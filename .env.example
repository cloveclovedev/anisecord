# ===========================================
# Discord Configuration
# ===========================================
DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_GUILD_ID=          # Optional: For instant command registration

# ===========================================
# LLM Configuration (Gemini)
# ===========================================
# If you use other models via litellm, set their respective keys (e.g. OPENAI_API_KEY)
GEMINI_API_KEY=

# ===========================================
# TickTick Integration
# ===========================================
# OAuth2 credentials from https://developer.ticktick.com/manage
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_ACCESS_TOKEN=
TICKTICK_REFRESH_TOKEN=

# ===========================================
# GitHub Integration
# ===========================================
# Personal Access Token with repo scope
GITHUB_TOKEN=
# Comma-separated list of repos to track (e.g. "owner/repo1,owner/repo2")
GITHUB_REPOS=

# ===========================================
# /daily-plan Feature
# ===========================================
# Discord channel ID where daily plan threads will be created
DAILY_PLAN_CHANNEL_ID=
# Thread name format ({date} is replaced with YYYY-MM-DD)
# DAILY_PLAN_THREAD_FORMAT={date} 日報
# Auto-post schedule (24h format, in DAILY_PLAN_TIMEZONE)
# DAILY_PLAN_SCHEDULE_HOUR=7
# DAILY_PLAN_SCHEDULE_MINUTE=0
# LLM model for plan generation (any litellm-compatible model)
# DAILY_PLAN_LLM_MODEL=gemini/gemini-3.1-pro-preview
# Timezone for scheduling and date formatting
# DAILY_PLAN_TIMEZONE=Asia/Tokyo
# Enabled task sources (comma-separated: ticktick,github)
# DAILY_PLAN_SOURCES=ticktick,github
